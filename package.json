{
  "name": "vivigames-local-tests",
  "private": true,
  "scripts": {
    "verify": "node tests/verify.cjs",
    "test": "playwright test",
    "test:runner": "playwright test tests/debug-mode.spec.js tests/backgrounds.spec.js",
    "test:boss": "playwright test tests/boss-battle.spec.js",
    "test:portal": "playwright test tests/portal.spec.js",
    "test:syntax": "node tests/verify.cjs",
    "test:backgrounds": "playwright test tests/backgrounds.spec.js",
    "test:update-backgrounds": "playwright test tests/backgrounds.spec.js --update-snapshots",
    "test:ui": "playwright test --ui",
    "test:hex": "node tools/hex/solver.test.mjs",
    "test:hex-ui": "playwright test tests/hexamine-ui.spec.js",
    "test:hr2": "playwright test tests/hell-runner-2-ui.spec.js",
    "test:champion": "playwright test tests/todays-champion.spec.js",
    "test:ranking": "playwright test tests/ranking-submit.spec.js",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:rhythm": "playwright test tests/rhythm-game.spec.js",
    "serve": "node tests/static-server.cjs",
    "portal:images": "node tools/portal-images.mjs",
    "champion:images": "node tools/todays-champion-images.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3"
  }
}
